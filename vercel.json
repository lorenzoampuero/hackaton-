{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "^/$",
      "dest": "/web/vecino.html"
    },
    {
      "src": "^/institucion/?$",
      "dest": "/web/institucion.html"
    },
    {
      "src": "^/profesional/?$",
      "dest": "/web/index.html"
    },
    {
      "src": "^/qr/?$",
      "dest": "/web/qr.html"
    },
    {
      "src": "^/(legal|privacidad|terminos)/?$",
      "dest": "/web/legal.html"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
