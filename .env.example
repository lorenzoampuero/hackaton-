# Copia este archivo como ".env" (no se sube al repositorio) y pon UNA clave.
# La clave la usan solo el pipeline y el servidor local; nunca llega al navegador.

# Opción 1: Google Gemini
GEMINI_API_KEY=
# PULMON_GEMINI_MODEL=gemini-2.5-flash

# Opción 2: OpenAI o cualquier API compatible
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PULMON_LLM_MODEL=gpt-4o-mini

# Límite de informes con IA por hora en el servidor local
# PULMON_IA_MAX_HORA=30
