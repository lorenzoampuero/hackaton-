# Configuración ejemplo para local (.env) y Vercel Environment Variables
# NUNCA subas tus claves reales al repositorio.

# Proveedor IA (DeepSeek / OpenAI / Gemini)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
PULMON_LLM_MODEL=deepseek-flash
PULMON_DEEPSEEK_EFFORT=low
# GEMINI_API_KEY=

# Límite de consultas IA por hora en el servidor
PULMON_IA_MAX_HORA=60

# Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
